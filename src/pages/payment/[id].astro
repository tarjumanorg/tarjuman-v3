---
import Layout from "../../layouts/Layout.astro";
import { createClient } from "../../lib/supabase";

const { id } = Astro.params;
const supabase = createClient(Astro);

if (!id) {
    return Astro.redirect("/404");
}

const {
    data: { user },
} = await supabase.auth.getUser();

if (!user) {
    return Astro.redirect(`/login?redirect=/payment/${id}`);
}

// Fetch order details
const { data: order, error } = await supabase
    .from("orders")
    .select("*, order_files(*)")
    .eq("id", id)
    .single();

if (error || !order) {
    console.error("Error fetching order:", error);
    return Astro.redirect("/404");
}

// Security: Ensure user owns the order
if (order.user_id !== user.id) {
    return Astro.redirect("/404");
}

// If already paid or pending verification, redirect to success
if (order.payment_status === "paid" || order.payment_status === "pending") {
    return Astro.redirect(`/payment/success/${id}`);
}

// Mayar requires a customer mobile number (>=10 digits) to create an invoice.
// Google sign-in never collects one, so prompt for it here if it's missing.
const { data: profile } = await supabase
    .from("profiles")
    .select("whatsapp_number")
    .eq("id", user.id)
    .single();

const needsPhone = !profile?.whatsapp_number || profile.whatsapp_number.replace(/\D/g, "").length < 10;

function formatPrice(price: number) {
    return new Intl.NumberFormat("id-ID", {
        style: "currency",
        currency: "IDR",
        minimumFractionDigits: 0,
    }).format(price);
}

const paymentAmount = Math.round(order.final_price || 0);
---

<Layout title={`Pembayaran Order #${id?.slice(0, 8)} - Tarjuman`}>
    <div
        class="container mx-auto py-20 px-4 max-w-2xl text-center"
        id="paymentRoot"
        data-order-id={id}
        data-needs-phone={needsPhone ? "true" : "false"}
    >
        <!-- Phone number state -->
        <div id="phoneState" class="max-w-md w-full mx-auto text-center space-y-6 hidden">
            <div
                class="h-20 w-20 mx-auto bg-primary/10 rounded-full flex items-center justify-center text-primary mb-6 ring-4 ring-primary/20"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="40"
                    height="40"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
            </div>

            <h1 class="text-2xl font-bold font-serif text-foreground">
                Satu Langkah Lagi
            </h1>

            <p class="text-muted-foreground">
                Masukkan nomor WhatsApp Anda untuk konfirmasi pembayaran dan
                notifikasi status pesanan.
            </p>

            <form id="phoneForm" class="text-left space-y-3">
                <label for="phoneInput" class="text-sm font-medium text-foreground">
                    Nomor WhatsApp
                </label>
                <input
                    id="phoneInput"
                    type="tel"
                    inputmode="numeric"
                    placeholder="08123456789"
                    required
                    class="flex w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                />
                <p id="phoneError" class="text-sm text-destructive"></p>
                <button
                    type="submit"
                    class="w-full inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground px-4 py-2.5 text-sm font-medium hover:bg-primary/90 transition-colors"
                >
                    Lanjutkan ke Pembayaran
                </button>
            </form>
        </div>

        <!-- Loading state -->
        <div id="loadingState" class="max-w-md w-full mx-auto text-center space-y-6">
            <div
                class="h-20 w-20 mx-auto bg-primary/10 rounded-full flex items-center justify-center text-primary mb-6 ring-4 ring-primary/20"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="40"
                    height="40"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="animate-spin"
                >
                    <path d="M21 12a9 9 0 1 1-6.219-8.56" />
                </svg>
            </div>

            <h1 class="text-2xl font-bold font-serif text-foreground">
                Mengarahkan ke Pembayaran
            </h1>

            <div class="text-muted-foreground space-y-2">
                <p class="animate-pulse">
                    Membuat invoice untuk {formatPrice(paymentAmount)}...
                </p>
                <p class="text-xs opacity-70 mt-4">
                    Anda akan diarahkan ke halaman pembayaran aman Mayar. Mohon
                    jangan tutup halaman ini.
                </p>
            </div>
        </div>

        <!-- Error state -->
        <div id="errorState" class="max-w-md w-full mx-auto text-center space-y-6 hidden">
            <div
                class="h-20 w-20 mx-auto bg-destructive/10 rounded-full flex items-center justify-center text-destructive mb-6"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="40"
                    height="40"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="12" />
                    <line x1="12" y1="16" x2="12.01" y2="16" />
                </svg>
            </div>

            <h1 class="text-2xl font-bold font-serif text-foreground">
                Oops, Terjadi Kesalahan
            </h1>

            <p id="errorMessage" class="text-muted-foreground"></p>

            <div class="pt-6 flex gap-3 justify-center">
                <a
                    href="/dashboard"
                    class="inline-flex items-center justify-center rounded-md border border-input bg-background px-4 py-2 text-sm font-medium hover:bg-accent transition-colors"
                >
                    Kembali ke Dashboard
                </a>
                <button
                    id="retryBtn"
                    class="inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground px-4 py-2 text-sm font-medium hover:bg-primary/90 transition-colors"
                >
                    Coba Lagi
                </button>
            </div>
        </div>
    </div>
</Layout>

<script>
    import { createClient } from "../../lib/supabase";

    const paymentRoot = document.getElementById("paymentRoot");
    const orderId = paymentRoot?.dataset.orderId ?? "";
    const needsPhone = paymentRoot?.dataset.needsPhone === "true";

    const phoneState = document.getElementById("phoneState");
    const phoneForm = document.getElementById("phoneForm");
    const phoneInput = document.getElementById("phoneInput") as HTMLInputElement | null;
    const phoneError = document.getElementById("phoneError");
    const loadingState = document.getElementById("loadingState");
    const errorState = document.getElementById("errorState");
    const errorMessage = document.getElementById("errorMessage");
    const retryBtn = document.getElementById("retryBtn");

    async function startPayment() {
        phoneState?.classList.add("hidden");
        loadingState?.classList.remove("hidden");
        errorState?.classList.add("hidden");

        try {
            const response = await fetch(`/api/orders/${orderId}/pay`, {
                method: "POST",
            });
            const data = await response.json();

            if (!response.ok || !data.paymentUrl) {
                throw new Error(data.error || "Gagal memulai pembayaran");
            }

            window.location.href = data.paymentUrl;
        } catch (err) {
            loadingState?.classList.add("hidden");
            errorState?.classList.remove("hidden");
            if (errorMessage) {
                errorMessage.textContent =
                    err instanceof Error
                        ? err.message
                        : "Terjadi kesalahan sistem.";
            }
        }
    }

    phoneForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const digitsOnly = (phoneInput?.value || "").replace(/\D/g, "");

        if (digitsOnly.length < 10) {
            if (phoneError) {
                phoneError.textContent = "Nomor WhatsApp minimal 10 digit.";
            }
            return;
        }

        if (phoneError) phoneError.textContent = "";
        phoneState?.classList.add("hidden");
        loadingState?.classList.remove("hidden");

        const supabase = createClient();
        const {
            data: { user },
        } = await supabase.auth.getUser();

        if (!user) {
            window.location.href = `/login?redirect=/payment/${orderId}`;
            return;
        }

        const { error } = await supabase
            .from("profiles")
            .update({ whatsapp_number: digitsOnly })
            .eq("id", user.id);

        if (error) {
            loadingState?.classList.add("hidden");
            phoneState?.classList.remove("hidden");
            if (phoneError) {
                phoneError.textContent = "Gagal menyimpan nomor. Coba lagi.";
            }
            return;
        }

        startPayment();
    });

    retryBtn?.addEventListener("click", startPayment);

    if (needsPhone) {
        loadingState?.classList.add("hidden");
        phoneState?.classList.remove("hidden");
    } else {
        startPayment();
    }
</script>
